# Client (Vite) — safe to expose, RLS protects data
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server (Netlify functions only — set in Netlify env, never in client code)
ANTHROPIC_API_KEY=sk-ant-...
# Same values as the VITE_ ones; functions read these to verify user JWTs
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Comma-separated origins allowed to call /api/* (defense in depth)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8888

# ---------- letting other people in, without letting them spend ----------
# All four are optional and everything is off unless set, so a deployment with
# one person on it behaves exactly as it did. See netlify/functions/_lib/who.ts.
#
# Who may run AI actions at all. Unset means anybody signed in — and Supabase
# auth is open, so anybody who ends up with the URL can sign in. Set this before
# the link leaves your hands.
# AI_ALLOWED_EMAILS=you@example.com, tester@example.com
#
# Who gets the full daily budget. Everybody else gets AI_GUEST_USD_CAP, which
# can only ever lower it.
# AI_OWNER_EMAILS=you@example.com
# AI_GUEST_USD_CAP=1.50
#
# …and the ceiling over everybody together, which is the only one that bounds a
# day: ten testers at $1.50 is $15 whatever each of their caps says. Needs
# migration 0007. Unset means no total ceiling.
# AI_TOTAL_USD_CAP=15

# --- Push notifications (optional; all four together, or none) ---
# The agent can finish a long run while your phone is locked and tell you about it.
# Generate a pair with `npx web-push generate-vapid-keys`. The public key has to be
# given twice: the server signs with it, and the browser subscribes with it.
# VAPID_PUBLIC_KEY=BN...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# VITE_VAPID_PUBLIC_KEY=BN...      # must be identical to VAPID_PUBLIC_KEY

# ---- inviting people (see supabase/migrations/0008) ----
# Turn the invite table on as the guest list. Off unless this is exactly "1",
# and with it on, an empty AI_ALLOWED_EMAILS stops meaning "everybody" — see
# letIn() in netlify/functions/_lib/who.ts.
# AI_INVITES=1
