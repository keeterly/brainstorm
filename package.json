{
  "name": "brainstorm",
  "private": true,
  "version": "0.1.0",
  "description": "Brainstorm \u2014 AI Thinking OS. Turns scattered thoughts into connected ideas, visual maps, and actionable plans.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src shared netlify e2e",
    "test:e2e": "VITE_DEMO=1 vite build --outDir e2e/.build && vitest run --config vitest.e2e.config.ts",
    "shots": "VITE_DEMO=1 vite build --outDir e2e/.build && vitest run --config vitest.shots.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jose": "^5.9.6",
    "jsdom": "^25.0.1",
    "playwright": "1.56.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
